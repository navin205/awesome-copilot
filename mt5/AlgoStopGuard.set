; ------------------------------------------------------------------
; AlgoStopGuard.set - preset for AlgoStopGuard.mq5
;
; Profile: Vantage cent account (USC), bot magic 777,
;          06:00-17:00 IST on weekdays, bank 5000-6000 USC.
;
; Load it with: EA properties -> Inputs tab -> "Load" -> pick this file.
; All values below are in the ACCOUNT CURRENCY (USC on a cent account).
;
; THE RULE: the Algo Trading button is only ever switched off when BOTH
;   day profit >= InpMinStopProfit (5000)  AND  drawdown <= InpMaxDrawdown (100)
; are true at that instant. Nothing below can override those two.
; ------------------------------------------------------------------

; === 1. What to track ===
; 0 = bot only (magic filtered), 1 = whole account equity
InpPnlBasis=0
InpFilterByMagic=true
InpMagicNumber=777
InpFilterBySymbol=false

; === 2. GATE - both must hold before the button is pressed ===
InpMinStopProfit=5000.0
InpMaxDrawdown=100.0
; 0 = open floating loss, 1 = give-back from day peak, 2 = worst of both
InpDrawdownMode=0

; === 3. WHEN to stop, once the gate is open ===
; Rule A fires at 6000 - 200 = 5800 ("or close to it")
InpEnableTargetRule=true
InpTargetProfit=6000.0
InpTargetTolerance=200.0
; Rule B: day peaked above the gate and has given back this much
InpEnableGivebackRule=true
InpPeakGiveback=400.0

; === 4. Session window (IST = GMT+5:30 = 330 minutes) ===
InpTzOffsetMinutes=330
InpStartHour=6
InpStartMinute=0
InpEndHour=17
InpEndMinute=0
InpWeekdaysOnly=true
InpOnlyInWindow=true
; Rule C: stop at 17:00 if the gate happens to be open then
InpStopAtWindowEnd=false

; === 5. Lock behaviour ===
InpEnforceLockAllDay=true
; Set InpDryRun=true for the first day to watch it without touching the button
InpDryRun=false

; === 6. Close out when the stop fires ===
; The gate already guarantees profit >= 5000 and drawdown <= 100,
; so whenever the button goes off the book is flattened too.
InpCloseOnStop=true
; 0 = every open position on the account, 1 = only magic-777 positions
InpCloseScope=0
; Pending orders still fire with AutoTrading off, so clear them too
InpDeletePendingOnClose=true
InpCloseSlippage=30
InpClosePasses=5

; === 7. Notifications & advanced ===
InpAlertOnStop=true
InpPushOnStop=false
InpShowPanel=true
InpTimerSeconds=1
InpMaxClickAttempts=5
; Terminal command id of the AutoTrading button (MT5 = 33020)
InpAlgoButtonCmdId=33020
